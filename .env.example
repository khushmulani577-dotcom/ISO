# Copy this file to .env and set your provider key before starting the backend.
AI_PROVIDER=gemini
AI_API_KEY=
# Used only with AI_PROVIDER=openai-compatible.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gemini-3.8-flash
PORT=3000
# Set by the production host when HTTPS is terminated in front of Node.
NODE_ENV=development
